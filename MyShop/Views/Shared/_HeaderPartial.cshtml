@inject ISiteSettingService SiteSettingService
@{
    var siteSettings = await SiteSettingService.GetAsync();
}

<header class="header-main site-header">
    <nav class="top-bar-menu" aria-label="منوی اصلی">
        <div class="container-main">
            <ul class="top-menu-ul site-top-links">
                <li class="top-menu-item"><a asp-action="Index" asp-controller="Product" class="top-menu-link">محصولات</a></li>
                <li class="top-menu-item"><a asp-action="ContactUs" asp-controller="Account" class="top-menu-link">تماس با ما</a></li>
                <li class="top-menu-item"><a asp-action="AboutUs" asp-controller="Home" class="top-menu-link">درباره ما</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="top-menu-item"><a asp-action="Profile" asp-controller="Account" class="top-menu-link">حساب من</a></li>
                }
            </ul>
        </div>
    </nav>

    <div class="container-main">
        <section class="site-header-row">
            <a asp-action="Index" asp-controller="Home" class="site-brand" aria-label="@siteSettings.SiteName">
                <img src="@siteSettings.LogoUrl" alt="لوگوی @siteSettings.SiteName" />
                <span>
                    <strong>@siteSettings.SiteName</strong>
                    @if (!string.IsNullOrWhiteSpace(siteSettings.SiteTagline))
                    {
                        <small>@siteSettings.SiteTagline</small>
                    }
                </span>
            </a>

            <div class="site-search">
                <form asp-action="Index" asp-controller="Product" method="get" class="form-search">
                    <label class="sr-only" for="site-product-search">جستجوی محصول</label>
                    <input id="site-product-search" type="search" class="header-search-input" name="searchProduct" placeholder="نام کالا را جستجو کنید…" value="@ViewBag.SearchProduct" />
                    @if (ViewData["Filter"] != null)
                    {
                        <input value="@ViewBag.FilterName" type="hidden" name="filter" />
                        @if (ViewBag.CategoriesId != null)
                        {
                            foreach (var item in ViewBag.CategoriesId)
                            {
                                <input value="@item" type="hidden" name="categoriesId" />
                            }
                        }
                    }
                    <button class="btn btn-search" type="submit" aria-label="جستجو"><i class="fa fa-search"></i></button>
                </form>
            </div>

            <div class="site-account">
                <span class="icon-account"><img src="/assets/images/man.png" class="avator" alt="حساب کاربری" /></span>
                <partial name="_AccountPartial" />
            </div>
        </section>

        <nav class="header-main-nav desktop-category-nav" aria-label="دسته‌بندی محصولات">
            <ul class="menu-ul mega-menu-level-one">@await Component.InvokeAsync("CategoryComponent")</ul>
        </nav>

        <nav class="sidebar" aria-label="دسته‌بندی موبایل">
            <div class="nav-header"><div class="header-cover"></div><div class="logo-wrap"><span class="logo-icon">@siteSettings.SiteName</span></div></div>
            @await Component.InvokeAsync("ResponsiveCategoryComponent")
        </nav>
        <button type="button" class="nav-btn nav-slider nav-btn-home-3" aria-label="باز کردن دسته‌بندی‌ها"><span class="linee1"></span><span class="linee2"></span><span class="linee3"></span></button>
        <div class="overlay"></div>
    </div>
</header>
<div class="nav-categories-overlay"></div>
