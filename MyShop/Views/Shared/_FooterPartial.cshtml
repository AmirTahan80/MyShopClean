@inject ISiteSettingService SiteSettingService
@{
    var siteSettings = await SiteSettingService.GetAsync();
}

<footer class="footer-main-site site-footer">
    <div class="container-main">
        <div class="site-footer-grid">
            <section class="site-footer-about">
                <h2>@(string.IsNullOrWhiteSpace(siteSettings.FooterTitle) ? siteSettings.SiteName : siteSettings.FooterTitle)</h2>
                <p>@siteSettings.FooterDescription</p>
            </section>

            <nav class="site-footer-links" aria-label="پیوندهای فوتر">
                <h3>دسترسی سریع</h3>
                <ul>
                    <li><a asp-action="Index" asp-controller="Product" asp-route-filter="New">جدیدترین محصولات</a></li>
                    <li><a asp-action="Index" asp-controller="Product" asp-route-filter="Cheaper">محصولات ارزان‌تر</a></li>
                    <li><a asp-action="ContactUs" asp-controller="Account">تماس با ما</a></li>
                    <li><a asp-action="AboutUs" asp-controller="Home">درباره ما</a></li>
                </ul>
            </nav>

            <section class="site-footer-contact">
                <h3>اطلاعات تماس</h3>
                @if (!string.IsNullOrWhiteSpace(siteSettings.Address))
                {
                    <p><i class="fa fa-map-marker"></i><span>@siteSettings.Address</span></p>
                }
                @if (!string.IsNullOrWhiteSpace(siteSettings.Phone))
                {
                    <p><i class="fa fa-phone"></i><a dir="ltr" href="tel:@siteSettings.Phone">@siteSettings.Phone</a></p>
                }
                @if (!string.IsNullOrWhiteSpace(siteSettings.SupportEmail))
                {
                    <p><i class="fa fa-envelope"></i><a dir="ltr" href="mailto:@siteSettings.SupportEmail">@siteSettings.SupportEmail</a></p>
                }
            </section>

            <section class="site-footer-newsletter">
                <h3>خبرنامه</h3>
                <p>از محصولات جدید و تخفیف‌ها باخبر شوید.</p>
                <form asp-action="JoinUs" asp-controller="Account" method="post" class="form-newsletter">
                    <label class="sr-only" for="footer-email">آدرس ایمیل</label>
                    <div class="newsletter-row">
                        <input id="footer-email" name="email" type="email" class="form-control" placeholder="آدرس ایمیل" required />
                        <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Home")" />
                        <button class="btn btn-secondary" type="submit">عضویت</button>
                    </div>
                </form>
            </section>
        </div>

        <div class="site-footer-bottom"><p>@(string.IsNullOrWhiteSpace(siteSettings.FooterCopyright) ? $"تمامی حقوق برای {siteSettings.SiteName} محفوظ است." : siteSettings.FooterCopyright)</p></div>
    </div>
</footer>
