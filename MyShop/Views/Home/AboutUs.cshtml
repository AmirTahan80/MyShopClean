@inject ISiteSettingService SiteSettingService
@{
    ViewData["Title"] = "درباره ما";
    var siteSettings = await SiteSettingService.GetAsync();
}

<div class="container-main">
    <div class="main-row">
        <div class="col-12">
            <div id="breadcrumb">
                <i class="fa fa-home"></i>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">خانه</a></li>
                        <li class="breadcrumb-item active" aria-current="page">درباره @siteSettings.SiteName</li>
                    </ol>
                </nav>
            </div>

            <section class="card p-4 mt-4 mb-5">
                <h1 class="h3 mb-3">درباره @siteSettings.SiteName</h1>
                @if (!string.IsNullOrWhiteSpace(siteSettings.SiteTagline))
                {
                    <p class="lead">@siteSettings.SiteTagline</p>
                }
                <p>@siteSettings.FooterDescription</p>

                <div class="row mt-4">
                    @if (!string.IsNullOrWhiteSpace(siteSettings.Address))
                    {
                        <div class="col-md-4 mb-3"><strong>آدرس</strong><p>@siteSettings.Address</p></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(siteSettings.Phone))
                    {
                        <div class="col-md-4 mb-3"><strong>تلفن</strong><p><a dir="ltr" href="tel:@siteSettings.Phone">@siteSettings.Phone</a></p></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(siteSettings.SupportEmail))
                    {
                        <div class="col-md-4 mb-3"><strong>ایمیل</strong><p><a dir="ltr" href="mailto:@siteSettings.SupportEmail">@siteSettings.SupportEmail</a></p></div>
                    }
                </div>
            </section>
        </div>
    </div>
</div>
