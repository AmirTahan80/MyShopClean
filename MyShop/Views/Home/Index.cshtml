@model HomePageViewModel
@{
    ViewData["Title"] = "خانه";
    int i = 0, d = 0, c = 0;
    var rightBanner = Model.Baners.FirstOrDefault(p => p.ImageLocation == "Right");
    var sliderBanners = Model.Baners.Where(p => p.ImageLocation == "Slider").ToList();
    var middleLeftBanner = Model.Baners.FirstOrDefault(p => p.ImageLocation == "MiddleLeft");
    var middleRightBanner = Model.Baners.FirstOrDefault(p => p.ImageLocation == "MiddleRight");
}

@section Header{
    <!-- plugin-------------------------------------->
    <link href="~/assets/css/vendor/nice-selectMin.css" rel="stylesheet" />

}


<!-- adplacement------------------------------->
<div class="container-main">
    @if (rightBanner != null)
    {
    <div class="col-lg-3 col-md-3 col-xs-12 pr">
        <div class="adplacement-container-row mt-4">
            <a href="@rightBanner.Link" class="adplacement-item">
                <div class="adplacement-sponsored_box">
                    <img src="/Images/Baners/@rightBanner.ImageSrc" style="max-height: 475px;" alt="@rightBanner.Text">
                </div>
            </a>
        </div>
    </div>
    }
    <!-- slider-main--------------------------->
    @if (sliderBanners.Count > 0)
    {
    <div class="@(rightBanner == null ? "col-lg-12 col-md-12" : "col-lg-9 col-md-9") col-xs-12 pl">
        <div class="slider-main-container d-block">
            <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
                <ol class="carousel-indicators">
                    @for (var b = 0; b < sliderBanners.Count; b++)
                    {
                        <li data-target="#carouselExampleIndicators" data-slide-to="@b" class="active"></li>
                    }
                </ol>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <a href="@sliderBanners[0].Link" class="adplacement-item">
                            <img src="/Images/Baners/@sliderBanners[0].ImageSrc" class="d-block w-100" alt="@sliderBanners[0].Text">
                        </a>
                    </div>
                    @foreach (var item in sliderBanners.Skip(1))
                    {
                        <div class="carousel-item">
                            <a href="@item.Link" class="adplacement-item">
                                <img src="/Images/Baners/@item.ImageSrc" class="d-block w-100" alt="@item.Text" style="max-height:490px">
                            </a>
                        </div>
                    }
                </div>
                <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
                    <span class="fa fa-angle-left" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
                    <span class="fa fa-angle-right" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>
        </div>
    </div>
    }
    <!-- moment-slider-------------------------->
    <!-- slider-amazing------------------------->
    <!-- adplacement--------------------------->


</div>
<!-- slider-product-------------------------------->
<div class="col-lg-12 col-md-12 col-xs-12 pr order-1 d-block">
    <div class="slider-widget-products slider-content-tabs">
        <div class="widget widget-product card slider-content-tabs">
            <header class="card-header header-product">
                <span class="title-one">جدید ترین محصولات</span>
                <h3 class="card-title"></h3>
            </header>
            <div class="product-carousel owl-carousel owl-theme owl-rtl owl-loaded owl-drag">
                <div class="owl-stage-outer">
                    <div class="owl-stage" style="transform: translate3d(0px, 0px, 0px); transition: all 0s ease 0s; width: 1534px;">
                        @foreach (var newProduct in Model.NewtProducts)
                        {
                            if (i <= 5)
                            {
                                <div class="owl-item active tab-item" style="width: 296.75px; margin-left: 10px;">
                                    <div class="item" style=" height: 228px; max-width: 322px;">
                                        <a asp-action="Description" asp-controller="Product" asp-route-productId="@newProduct.Id" class="d-block hover-img-link">
                                            <img src="~/Images/ProductImages/@newProduct.ImageSrc" class="img-fluid" alt="@newProduct.Name" style=" max-height: 228px; object-fit: contain;">
                                        </a>
                                    </div>
                                    <div class="item" style="padding-top: 5px;">
                                        <h2 class="post-title">
                                            <a asp-action="Description" asp-controller="Product" asp-route-productId="@newProduct.Id">
                                                @newProduct.Name
                                            </a>
                                        </h2>
                                        <div class="price">
                                            <ins><span>@newProduct.Price.ToString("#,0")<span>تومان</span></span></ins>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="owl-item tab-item" style="width: 296.75px; margin-left: 10px;">
                                    <div class="item" style=" height: 228px; max-width: 322px;">
                                        <a asp-action="Description" asp-controller="Product" asp-route-productId="@newProduct.Id" class="d-block hover-img-link">
                                            <img src="~/Images/ProductImages/@newProduct.ImageSrc" class="img-fluid" alt="@newProduct.Name" style=" max-height: 228px; object-fit: contain;">
                                        </a>
                                    </div>
                                    <div class="item" style="padding-top: 5px;">
                                        <h2 class="post-title">
                                            <a asp-action="Description" asp-controller="Product" asp-route-productId="@newProduct.Id">
                                                @newProduct.Name
                                            </a>
                                        </h2>
                                        <div class="price">
                                            <ins><span>@newProduct.Price.ToString("#,0")<span>تومان</span></span></ins>
                                        </div>
                                    </div>
                                </div>
                            }
                            i++;
                        }
                    </div>
                </div>
                <div class="owl-nav">
                    <button type="button" role="presentation" class="owl-prev disabled">
                        <i class="fa fa-angle-right"></i>
                    </button>
                    <button type="button" role="presentation" class="owl-next">
                        <i class="fa fa-angle-left"></i>
                    </button>
                </div>
                <div class="owl-dots disabled"></div>
                <div class="owl-nav"><button type="button" role="presentation" class="owl-prev disabled"><i class="fa fa-angle-right"></i></button><button type="button" role="presentation" class="owl-next"><i class="fa fa-angle-left"></i></button></div><div class="owl-dots disabled"></div>
            </div>
        </div>
    </div>
</div>
