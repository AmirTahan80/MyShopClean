                        <i class="fa fa-angle-left"></i>
                    </button>
                </div>
                <div class="owl-dots disabled"></div>
                <div class="owl-nav"><button type="button" role="presentation" class="owl-prev disabled"><i class="fa fa-angle-right"></i></button><button type="button" role="presentation" class="owl-next"><i class="fa fa-angle-left"></i></button></div><div class="owl-dots disabled"></div>
            </div>
        </div>
    </div>
</div>
<!-- adplacement--------------------------->
@if (middleLeftBanner != null || middleRightBanner != null)
{
<div class="container-main">
    <div class="adplacement-container-row">
        @if (middleLeftBanner != null)
        {
        <div class="col-6 col-lg-6 pr">
            <a href="@middleLeftBanner.Link" class="adplacement-item">
                <div class="adplacement-sponsored_box">
                    <img src="/Images/Baners/@middleLeftBanner.ImageSrc" style="max-height: 236px;" alt="@middleLeftBanner.Text">
                </div>
            </a>
        </div>
        }
        @if (middleRightBanner != null)
        {
        <div class="col-6 col-lg-6 pr">
            <a href="@middleRightBanner.Link" class="adplacement-item">
                <div class="adplacement-sponsored_box">
                    <img src="/Images/Baners/@middleRightBanner.ImageSrc" style="max-height: 236px;" alt="@middleRightBanner.Text">
                </div>
            </a>
        </div>
        }
    </div>
</div>
}
